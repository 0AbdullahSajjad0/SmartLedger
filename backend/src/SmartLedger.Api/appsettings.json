{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "smartledger-api",
    "Audience": "smartledger-web"
  },
  "Storage": {
    "Provider": "AzureBlob",
    "ContainerName": "receipts"
  },
  "Email": {
    "Provider": "AzureCommunicationServices"
  }
}
