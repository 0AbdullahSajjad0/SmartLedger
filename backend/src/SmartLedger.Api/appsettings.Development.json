{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=SmartLedger;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Jwt": {
    "SigningKey": "local-development-only-key-never-used-in-production-0123456789"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/receipts"
  },
  "Email": {
    "Provider": "Local",
    "LocalPath": "App_Data/emails",
    "AppUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
