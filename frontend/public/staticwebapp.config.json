{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,map,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,txt,json}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
